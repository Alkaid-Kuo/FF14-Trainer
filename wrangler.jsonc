{
  // 絕神兵練習器：網頁＋連線伺服器（在 repo 最上層執行 npx wrangler deploy）
  "name": "ff14-trainer",
  "main": "server/worker.js",
  "compatibility_date": "2025-09-01",
  // 開啟 ff14-trainer.<帳號>.workers.dev 網址
  "workers_dev": true,
  "assets": { "directory": "./server/public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // 免費方案要用 SQLite 型的 Durable Object
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
